# Copy to .env only for a new setup. Preserve existing database credentials.
POSTGRES_PASSWORD=replace-with-your-local-password
# Used by Python/Alembic running on your host. URL-encode reserved password characters.
DATABASE_URL=postgresql+psycopg://finance_user:replace-with-your-local-password@127.0.0.1:5433/finance_engine
# Optional host ports for Docker; change if a local dev server already uses them.
FRONTEND_PORT=3001
BACKEND_PORT=8001
POSTGRES_PORT=5433
